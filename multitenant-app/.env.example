# ============================================================
# FurnishedPortal Multi-tenant App — Environment Variables
# ============================================================
# Copy to .env.local and fill in values.
# NEVER commit .env.local to git.

# --- Database (NEW Neon project: furnishedportal-multitenant) ---
# Pooler URL — used by the app at runtime (serverless-safe)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct URL — used by Prisma migrate only (no PgBouncer)
DIRECT_DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=   # openssl rand -base64 32

# --- Platform encryption key (for BYO Stripe keys stored in DB) ---
FP_ENCRYPTION_KEY=  # openssl rand -base64 32  — paste the Vercel copy here

# --- Admin panel ---
# Per-landlord admin credentials are in the User table (bcrypt).
# This key grants super-admin access to platform API routes only.
PLATFORM_ADMIN_KEY=  # openssl rand -hex 32

# --- AI Chatbot ---
OPENAI_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@furnishedportal.com

# --- AWS S3 (gallery uploads) ---
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Platform Stripe (FurnishedPortal SaaS billing) ---
# These are FurnishedPortal's OWN Stripe keys, not the landlord's.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

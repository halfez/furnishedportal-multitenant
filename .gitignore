# Safety net — nested .gitignore files cover most cases, but this ensures
# node_modules are never accidentally committed from any subfolder.
node_modules/

# Research / bulk export files — not source code
*.zip

# Dev server log
multitenant-app/dev-server.log

# Archived reference code — kept on disk, not tracked in git
# (template-path-b was a submodule; easier to gitignore the whole folder)
_archive/
